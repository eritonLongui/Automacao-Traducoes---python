# Configurações da API Gemini
GEMINI_API_KEY=sua_chave_gemini_aqui

# Configurações de Envio de E-mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@nostrali.com.br

SMTP_PASSWORD=sua_senha_de_app_aqui
# você não deve colocar sua senha comum de login.
# É necessário gerar uma Senha de App
# (Google: Gerenciar Conta Google > Segurança > Verificação em duas etapas > Senhas de app).
